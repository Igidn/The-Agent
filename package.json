{
  "name": "the-agent",
  "version": "0.1.0",
  "description": "The last general-use agent you will need.",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsc --watch & node --watch dist/main.js",
    "eval": "node --env-file-if-exists=.env dist/eval/main.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --check src/",
    "format:fix": "prettier --write src/",
    "test": "tsc && node --test 'dist/**/*.test.js'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Igidn/The-Agent.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Igidn/The-Agent/issues"
  },
  "homepage": "https://github.com/Igidn/The-Agent#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.0",
    "@types/ws": "^8.18.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "typescript": "~5.7",
    "typescript-eslint": "^8.69.0"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.84.4",
    "@earendil-works/pi-ai": "^0.84.4",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@huggingface/transformers": "^4.2.0",
    "better-sqlite3": "^13.0.3",
    "onnxruntime-node": "^1.29.0",
    "sqlite-vec": "^0.1.9",
    "typebox": "^1.3.7",
    "ws": "^8.21.3"
  }
}
